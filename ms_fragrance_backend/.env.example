PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:your-password@db.example.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images
# Online payments (Razorpay test mode keys are safe to use in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional persistent SQLite file path for production hosting
# DB_PATH=/persistent/path/ms_fragrance.db
# Optional persistent upload root
# UPLOAD_DIR=/persistent/path/uploads
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# AI product image generation (OpenAI). gpt-image-2 is used with a reference image.
OPENAI_API_KEY=
# Product image provider: "openai" (default), "edenai" or "cloudflare". The
# default keeps the built-in OpenAI gpt-image-2 reference-image flow; "edenai"
# routes product images through the Eden AI gateway (POST /v3/images/edits);
# "cloudflare" routes product images through Cloudflare Workers AI.
PRODUCT_IMAGE_PROVIDER=openai
# Eden AI settings — only used when PRODUCT_IMAGE_PROVIDER=edenai.
# The default model is the same gpt-image-2 model via Eden AI, which supports
# reference-image input on the edits endpoint.
EDEN_AI_API_KEY=
EDEN_AI_IMAGE_MODEL=openai/gpt-image-2
# Cloudflare Workers AI settings — only used when
# PRODUCT_IMAGE_PROVIDER=cloudflare. flux-1-schnell is a text-to-image model,
# so the master bottle reference image is NOT sent to this provider; the
# shared product prompt (which describes the bottle) is used instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# AI Fill text provider: "openai" (default, gpt-5.5) or "cloudflare".
# Only used when PRODUCT_TEXT_PROVIDER=cloudflare. Shares the Cloudflare
# account/token above. The default text model supports JSON Mode; the image
# model above is text-to-image only and CANNOT generate text.
PRODUCT_TEXT_PROVIDER=openai
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
# Optional: override the master bottle reference image path used for AI product
# images. Absolute path, or relative to the backend src/shared/ai module dir.
# Defaults to the bundled asset: src/assets/ms-fragrance-master.png
# MASTER_PRODUCT_IMAGE_PATH=/absolute/path/to/ms-fragrance-master.png
