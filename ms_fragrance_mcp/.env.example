# Backend API URL (required)
BACKEND_API_URL=https://your-backend-domain.com

# Backend Service Key (required) - separate from admin JWT, used only server-to-server
BACKEND_SERVICE_KEY=<dedicated_service_key>

# MCP Access Key (required) - verified against Authorization: Bearer <token> header
MCP_ACCESS_KEY=<strong_random_different_from_service_key>

# MCP server port (default: 3001)
MCP_PORT=3001

# Node environment
NODE_ENV=production